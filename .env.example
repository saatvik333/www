# GitHub personal access token (read-only) for /about contributions calendar
GITHUB_TOKEN=
# Gmail address for contact form sender
SMTP_EMAIL=
# Gmail app password
SMTP_PASSWORD=
# Additional allowed domains for contact form (comma-separated, optional)
ALLOWED_CONTACT_ORIGINS=
# Set to 1 when self-hosted behind your own reverse proxy (nginx/Caddy) so the
# contact rate limiter trusts the last x-forwarded-for hop instead of bucketing
# all visitors under one "unknown" key
TRUST_PROXY=
